NODE_ENV=development
PORT=3000
# Address to listen on; every interface when empty (production: 127.0.0.1 behind nginx)
HOST=
LOG_LEVEL=debug
# Proxies in front of the server (production behind Caddy: 1)
TRUST_PROXY=0

# compose.yaml exposes Postgres on 5442 and Redis on 6390
DATABASE_URL=postgresql://lunex:lunex@localhost:5442/lunex
REDIS_URL=redis://localhost:6390

# Optional: errors are reported to Sentry only when a DSN is set
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Auth secrets: at least 32 characters each. Generate with `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
AUTH_CODE_PEPPER=

# Comma-separated audiences. Apple: the iOS bundle id. Google: the iOS OAuth client id.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Login-only Telegram bot (set its domain in @BotFather). Telegram sign-in is off when empty.
TELEGRAM_BOT_TOKEN=
# Public https origin of this server (the bot's domain in @BotFather); Telegram redirects back here.
PUBLIC_URL=

# console (development: codes are printed to the log) | resend | off (no email sign-in)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Push: log (only logged) | simulator (`xcrun simctl push` into SIMULATOR_DEVICE, a Mac) | apns
PUSH_PROVIDER=log
SIMULATOR_DEVICE=booted
# apns: the key from Apple Developer → Keys; the .p8 contents on one line with \n
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=uz.lunex.finance
# Xcode debug builds get sandbox tokens; TestFlight and the App Store production ones
APNS_ENVIRONMENT=sandbox

# Claude API (AI features answer `ai_unavailable` without a key)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMART=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# Photos of receipts (a folder on this machine)
STORAGE_DIR=storage
