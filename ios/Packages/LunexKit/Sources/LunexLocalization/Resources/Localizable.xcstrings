    "accounts.includeInTotal.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off for money you don't plan to spend, like a deposit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите для денег, которые не собираетесь тратить, например вклада."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarflash niyatingiz boʻlmagan pul uchun oʻchiring, masalan, omonat."
          }
        }
      }
    },
