    "empty.budget.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add income and the daily limit appears here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте доход — и здесь появится дневной лимит."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Daromad qoʻshing — bu yerda kunlik limit paydo boʻladi."
          }
        }
      }
    },
    "empty.budget.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
