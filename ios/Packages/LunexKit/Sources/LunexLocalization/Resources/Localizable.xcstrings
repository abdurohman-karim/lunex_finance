    "onboarding.income.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roughly is fine. The daily limit uses it until your real income is in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно примерно. По этой сумме считается дневной лимит, пока нет настоящих доходов."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxminan boʻlsa ham boʻladi. Haqiqiy daromad kiritilmaguncha kunlik limit shu summa boʻyicha hisoblanadi."
          }
        }
      }
    },
    "onboarding.income.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much do you earn a month?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько вы получаете в месяц?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyiga qancha daromad qilasiz?"
          }
        }
      }
    },
    "onboarding.language.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change it later in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык можно поменять в настройках."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilni keyin sozlamalarda oʻzgartirish mumkin."
          }
        }
      }
    },
    "onboarding.language.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which language do you prefer?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На каком языке удобнее?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qaysi tilda qulay?"
          }
        }
      }
    },
