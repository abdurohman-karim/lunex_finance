          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kechqurun: unutgan boʻlsangiz, xarajatlarni yozing"
          }
        }
      }
    },
    "onboarding.notifications.example.sun.max": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the morning: how much you can put aside today"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
