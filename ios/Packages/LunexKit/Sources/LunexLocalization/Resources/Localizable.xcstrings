{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunex Finance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunex Finance"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunex Finance"
          }
        }
      }
    },
    "app.tagline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know what you can spend today. Save without thinking about it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайте, сколько можно потратить сегодня. Копите без усилий."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugun qancha sarflash mumkinligini biling. Oson jamgʻaring."
          }
        }
      }
    },
    "common.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка…"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuklanmoqda…"
          }
        }
      }
    },
    "common.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qayta urinish"
          }
        }
      }
    },
    "empty.budget.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add income and the daily limit appears here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте доход — и здесь появится дневной лимит."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Daromad qoʻshing — bu yerda kunlik limit paydo boʻladi."
          }
        }
      }
    },
    "empty.budget.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget works on its own"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджет работает сам"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Byudjet oʻzi ishlaydi"
          }
        }
      }
    },
    "empty.goals.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a template and start saving."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите шаблон и начните копить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Andozani tanlang va jamgʻarishni boshlang."
          }
        }
      }
    },
    "empty.goals.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No goals yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целей пока нет"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha maqsadlar yoʻq"
          }
        }
      }
    },
    "empty.transactions.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first expense or income — it takes two taps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте первый расход или доход — это два касания."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinchi xarajat yoki daromadni qoʻshing — bu ikki bosish."
          }
        }
      }
    },
    "empty.transactions.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No operations yet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операций пока нет"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha amallar yoʻq"
          }
        }
      }
    },
