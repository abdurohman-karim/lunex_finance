    "onboarding.notifications.example.moon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the evening: log today's spending if you forgot"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
