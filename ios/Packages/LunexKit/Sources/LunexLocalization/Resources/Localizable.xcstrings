        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджет работает сам"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Byudjet oʻzi ishlaydi"
          }
        }
      }
