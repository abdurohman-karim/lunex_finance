    "onboarding.currency.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance and budget are counted in it. We'll open a Cash account in it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ней считаются баланс и бюджет. Счёт «Наличные» создадим в этой валюте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Balans va byudjet unda hisoblanadi. «Naqd pul» hisobini shu valyutada ochamiz."
          }
        }
      }
    },
