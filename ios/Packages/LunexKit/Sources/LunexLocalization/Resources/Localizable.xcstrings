            "state": "translated",
            "value": "Pochta"
          }
        }
      }
    },
    "account.error.admin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An administrator account can't be deleted here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт администратора здесь удалить нельзя."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator akkauntini bu yerda oʻchirib boʻlmaydi."
          }
        }
      }
    },
    "account.error.alreadyLinked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A method of this kind is already linked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Способ такого типа уже привязан."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunday turdagi usul allaqachon bogʻlangan."
          }
        }
      }
    },
    "account.error.inUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This method already belongs to another Lunex account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот способ входа уже принадлежит другому аккаунту Lunex."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kirish usuli boshqa Lunex akkauntiga tegishli."
          }
        }
      }
    },
    "account.error.last": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last sign-in method can't be removed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний способ входа отвязать нельзя."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxirgi kirish usulini uzib boʻlmaydi."
          }
        }
      }
    },
