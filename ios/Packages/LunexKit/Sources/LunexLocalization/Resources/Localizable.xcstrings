    "accounts.initialBalance.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the account held before you started Lunex. Tap ± for a card debt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько было на счёте до начала учёта в Lunex. «±» — для долга по карте."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunexdan oldin hisobda qancha boʻlgan. Karta qarzi uchun «±» ni bosing."
          }
        }
