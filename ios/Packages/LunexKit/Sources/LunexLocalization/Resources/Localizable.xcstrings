          "stringUnit": {
            "state": "translated",
            "value": "Раз в день. При подтверждении сумма пересчитывается: если она уменьшилась, деньги не списываются, а показывается новая сумма."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuniga bir marta. Tasdiqlashda summa qayta hisoblanadi: kamaygan boʻlsa, pul yechilmaydi va yangi summa koʻrsatiladi."
          }
        }
      }
    },
