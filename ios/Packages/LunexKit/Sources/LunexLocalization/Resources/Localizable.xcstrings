{
  "sourceLanguage": "en",
  "strings": {
    "account.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkauntni oʻchirish"
          }
        }
      }
    },
    "account.delete.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the account?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkaunt oʻchirilsinmi?"
          }
        }
      }
    },
    "account.delete.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is erased in 30 days. Signing in before that brings the account back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные будут стёрты через 30 дней. Если войти раньше, аккаунт восстановится."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Maʼlumotlar 30 kundan keyin oʻchiriladi. Undan oldin kirsangiz, akkaunt tiklanadi."
          }
        }
      }
    },
    "account.email": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
