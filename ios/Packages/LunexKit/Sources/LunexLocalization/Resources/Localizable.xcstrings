    "onboarding.notifications.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most three a day, and never at night."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не больше трёх в день и никогда ночью."
          }
