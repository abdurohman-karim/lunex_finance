    "account.methods.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A method with the same verified email links by itself. The last method can't be removed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Способ с той же подтверждённой почтой привязывается сам. Последний способ отвязать нельзя."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuddi shu tasdiqlangan pochtali usul oʻzi bogʻlanadi. Oxirgi usulni uzib boʻlmaydi."
          }
        }
      }
