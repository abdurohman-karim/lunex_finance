    "empty.transactions.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first expense or income — it takes two taps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте первый расход или доход — это два касания."
