	header Content-Type "text/html; charset=utf-8"
	respond `<!doctype html><html lang="ru"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Lunex Finance</title><body style="font-family:-apple-system,system-ui,sans-serif;background:#F4F4F5;color:#141416;display:grid;place-items:center;min-height:100vh;margin:0"><main style="text-align:center"><h1 style="font-weight:300;font-size:40px;margin:0">Lunex Finance</h1><p style="color:#6B6B70">Личные финансы на iPhone. Скоро в App Store.</p></main></body></html>` 200
}
