# /home/lunex/app/.env on the server. setup.sh creates it on the first deploy with fresh secrets
# and the database URL; edit it there, then run `docker compose up -d` in /home/lunex/app.

# The server's PostgreSQL: database and role lunex_db (setup.sh fills this in)
DATABASE_URL=
# The server's Redis, database 10 (0 and 2 belong to other projects)
REDIS_URL=redis://127.0.0.1:6379/10

# At least 32 characters each (setup.sh generates them)
JWT_ACCESS_SECRET=
AUTH_CODE_PEPPER=

LOG_LEVEL=info
PUBLIC_URL=https://api.lunex.my

# Sign-in methods; a method without its settings is off and the app does not offer it
APPLE_CLIENT_IDS=uz.lunex.finance
GOOGLE_CLIENT_IDS=
TELEGRAM_BOT_TOKEN=

# off until a mail service is set up; then resend with its key and a sender on a domain
# verified in Resend, e.g. EMAIL_FROM=Lunex Finance <no-reply@lunex.my>
EMAIL_PROVIDER=off
RESEND_API_KEY=
EMAIL_FROM=

# Push notifications: log (only logged) until the APNs key is set; then apns with the key
# from Apple Developer → Keys («Apple Push Notifications service»), its .p8 on one line with \n
PUSH_PROVIDER=log
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=uz.lunex.finance
APNS_ENVIRONMENT=production

SENTRY_DSN=
