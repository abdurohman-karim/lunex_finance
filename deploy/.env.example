# /home/lunex/app/.env on the server. deploy.sh creates it on the first run with fresh secrets;
# edit it there, then run deploy.sh again (or `docker compose up -d` in /home/lunex).

# Database password, used by the postgres service and the API
POSTGRES_PASSWORD=

# At least 32 characters each: openssl rand -base64 48
JWT_ACCESS_SECRET=
AUTH_CODE_PEPPER=

LOG_LEVEL=info
PUBLIC_URL=https://api.lunex.my

# Sign-in methods; a method without its settings is off and the app does not offer it
APPLE_CLIENT_IDS=uz.lunex.finance
GOOGLE_CLIENT_IDS=
TELEGRAM_BOT_TOKEN=

# off until a mail service is set up; then resend with its key and a sender on a domain
# verified in Resend, e.g. EMAIL_FROM=Lunex Finance <no-reply@lunex.my>
EMAIL_PROVIDER=off
RESEND_API_KEY=
EMAIL_FROM=

SENTRY_DSN=
